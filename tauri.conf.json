{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "to_words",
  "version": "0.1.0",
  "identifier": "com.towords.desktop",
  "build": {
    "frontendDist": "./frontend/dist",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "to_words · 设置",
        "url": "index.html?view=settings",
        "width": 800,
        "height": 600,
        "minWidth": 650,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["assets/icons/to_words_tray_source.png"]
  }
}
